[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='Orchis-Dark'
icon-theme='kora'
cursor-theme='oreo_blue_cursors'

[org.gnome.desktop.interface]
scaling-factor=1

[org.gnome.shell]
enabled-extensions=['arcmenu@arcmenu.com','blur-my-shell@aunetx','clipboard-indicator@tudmotu.com','dash-to-dock@micxgx.gmail.com','drive-menu@gnome-shell-extensions.gcampax.github.com','nightthemeswitcher@romainvigier.fr','user-theme@gnome-shell-extensions.gcampax.github.com','Vitals@CoreCoding.com']

[org.gnome.shell.extensions.user-theme]
name='Orchis-Dark'
